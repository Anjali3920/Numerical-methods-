Cell[CellGroupData[{

Cell["ques 4 lagrange method", "Chapter",
 CellChangeTimes->{{4.003896125384945*^9, 4.0038961404715776`*^9}, {
  4.0038963371209354`*^9, 4.0038963465377855`*^9}, {4.0038973640571947`*^9, 
  4.0038973649677744`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"LagrangePolynomial", "[", 
   RowBox[{"x0_", ",", "f0_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xi", "=", "x0"}], ",", 
      RowBox[{"fi", "=", "f0"}], ",", "n", ",", "m", ",", "polynomial"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "xi", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "fi", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[NotEqual]", "m"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<List of Points and Function values are not of same size\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "\[LessEqual]", "n"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"L", "[", 
          RowBox[{"i", ",", "x_"}], "]"}], "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"xi", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"xi", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", 
                RowBox[{"xi", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"xi", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"xi", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", 
                RowBox[{"xi", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], ")"}]}]}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"polynomial", "[", "x_", "]"}], "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"L", "[", 
