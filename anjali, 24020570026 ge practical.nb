Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Nmax", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eps", "=", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "6"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<f[x]=\>\"", ",", 
    RowBox[{"f", "[", "x", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "\[LessEqual]", "Nmax"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x2", "=", 
      RowBox[{"N", "[", 
       RowBox[{"x1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"f", "[", "x", "]"}], "/.", 
           RowBox[{"x", "\[Rule]", "x1"}]}], ")"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x1", "-", "x0"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f", "[", "x", "]"}], "/.", 
              RowBox[{"x", "\[Rule]", "x1"}]}], ")"}], "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f", "[", "x", "]"}], "/.", 
              RowBox[{"x", "\[Rule]", "x0"}]}], ")"}]}], ")"}]}]}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"x1", "-", "x2"}], "]"}], "<", "eps"}], ",", 
       RowBox[{"Return", "[", "x2", "]"}], ",", 
       RowBox[{
        RowBox[{"x0", "=", "x1"}], ";", 
        RowBox[{"x1", "=", "x2"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<In\>\"", ",", "i", ",", 
       "\"\<th Number of iterations the root is :\>\"", ",", "x2"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<estimated error is :\>\"", ",", 
       RowBox[{"Abs", "[", 
        RowBox[{"x1", "-", "x0"}], "]"}]}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<root is :\>\"", ",", "x2"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<estimated error is:\>\"", ",", 
    RowBox[{"Abs", "[", 
     RowBox[{"x2", "-", "x1"}], "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.003893115340143*^9, 4.003893116476012*^9}, {
  4.0038933054615555`*^9, 4.0038933103803473`*^9}}],

