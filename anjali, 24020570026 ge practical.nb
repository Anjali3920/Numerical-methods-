Cell[CellGroupData[{

Cell["\<\
question 2 gauss seidal
\
\>", "Chapter",
 CellChangeTimes->{{4.0038935428107557`*^9, 4.0038935480424633`*^9}, 
   4.003893666074363*^9, 4.0038939924255204`*^9, {4.003895596755369*^9, 
   4.0038955995454054`*^9}}],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9996610533943768`*^9, 3.999661067774191*^9}, {
   3.9996611027194843`*^9, 3.9996611677261496`*^9}, {3.9996612428780413`*^9, 
   3.9996614176470075`*^9}, {3.999661465789508*^9, 3.9996615685916057`*^9}, {
   3.999661750927244*^9, 3.9996618556770053`*^9}, {4.0038936830753365`*^9, 
   4.003893684170312*^9}, {4.003893751104578*^9, 4.0038938332111273`*^9}, 
   4.0038940782608366`*^9}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GaussSeidel", "[", 
     RowBox[{"A0_", ",", "b0_", ",", "X0_", ",", "maxtier_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"N", "[", "A0", "]"}]}], ",", 
        RowBox[{"b", "=", 
         RowBox[{"N", "[", "b0", "]"}]}], ",", 
        RowBox[{"xk", "=", "X0"}], ",", "xk1", ",", "i", ",", "j", ",", 
        RowBox[{"k", "=", "0"}], ",", "n", ",", "m", ",", "OutputDetails"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"size", "=", 
        RowBox[{"Dimensions", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"size", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"size", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "\[NotEqual]", "m"}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<Not a square matrix, cannot proceed with Gauss se method\>\"",
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"OutputDetails", "=", 
        RowBox[{"{", "xk", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xk1", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"k", "<", "maxtier"}], ",", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "\[LessEqual]", "n"}], ",", 
            RowBox[{"i", "++"}], ",", 
            RowBox[{
             RowBox[{"xk1", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", 
                RowBox[{"A", "[", 
                 RowBox[{"[", 
